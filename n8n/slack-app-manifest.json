{
  "display_information": {
    "name": "Enterprise Assistant",
    "description": "Approvals, document notifications and ticket updates from the enterprise voice avatar assistant",
    "background_color": "#ee0000"
  },
  "features": {
    "bot_user": {
      "display_name": "Enterprise Assistant",
      "always_online": true
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": ["chat:write", "chat:write.public", "channels:read", "channels:join", "channels:manage", "users:read"]
    }
  },
  "settings": {
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://N8N_HOST/webhook/slack-interactions"
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
