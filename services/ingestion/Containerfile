# Ingestion service: Docling parsing, chunking, embeddings, Qdrant upsert.
# Runs as the UBI Python image's unprivileged user; all models are baked in so
# the container needs no internet access at run time.
FROM registry.access.redhat.com/ubi9/python-312:latest

ENV UV_CACHE_DIR=/tmp/uv-cache \
    UV_LINK_MODE=copy \
    PIP_NO_CACHE_DIR=1 \
    DOCLING_ARTIFACTS_PATH=/opt/app-root/src/models/docling \
    HF_HOME=/opt/app-root/src/models/hf

WORKDIR /opt/app-root/src

COPY --chown=1001:0 pyproject.toml uv.lock ./
RUN pip install --no-cache-dir uv \
 && uv sync --frozen --no-dev \
 && rm -rf /tmp/uv-cache

# Docling layout and table models plus the chunker tokenizer.
RUN .venv/bin/docling-tools models download layout tableformer -o "$DOCLING_ARTIFACTS_PATH" \
 && .venv/bin/python -c "from transformers import AutoTokenizer; AutoTokenizer.from_pretrained('BAAI/bge-m3')"

COPY --chown=1001:0 app ./app

ENV HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    OMP_NUM_THREADS=4

EXPOSE 8080
CMD [".venv/bin/uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8080"]
